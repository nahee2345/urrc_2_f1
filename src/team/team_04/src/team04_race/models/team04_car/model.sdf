          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="team04_imu_fixed" type="fixed">
      <parent>base_link</parent>
      <child>team04_imu_link</child>
    </joint>
    <plugin filename="libteam04_vehicle_system.so" name="team04::VehicleSystem" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
  </model>
</sdf>