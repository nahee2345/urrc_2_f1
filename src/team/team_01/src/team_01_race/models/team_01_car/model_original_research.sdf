      <sensor name="front_camera" type="camera">
        <topic>/team_01/camera/image_raw</topic>
        <gz_frame_id>team_01/camera_optical_frame</gz_frame_id>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>2.09439510239</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>50</far>
          </clip>
          <camera_info_topic>/team_01/camera/camera_info</camera_info_topic>
        </camera>
      </sensor>
