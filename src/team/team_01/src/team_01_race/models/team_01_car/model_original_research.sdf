    <joint name="camera_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <frame name="laser_frame" attached_to="team_01_lidar_link">
      <pose relative_to="team_01_lidar_link">0 0 0 0 0 0</pose>
    </frame>
    <frame name="camera_optical_frame" attached_to="camera_link">
      <pose relative_to="camera_link">0 0 0 -1.57079632679 0 -1.57079632679</pose>
    </frame>
    
    <link name="imu_link">
      <pose>0 0 0.045 0 0 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.0000001</ixx><iyy>0.0000001</iyy><izz>0.0000001</izz></inertia></inertial>
      <sensor name="team_01_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/team_01/imu</topic>
        <gz_frame_id>team_01/imu_link</gz_frame_id>
        <imu><orientation_reference_frame><localization>ENU</localization></orientation_reference_frame></imu>
      </sensor>
    </link>
    <joint name="imu_fixed_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>
    
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
