        <pose>0 0 .07 0 0 0</pose>
        <topic>/team_05/scan</topic>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
