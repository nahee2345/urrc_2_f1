<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="team03_car">
  <xacro:arg name="with_lidar" default="true"/>
  <xacro:arg name="with_camera" default="false"/>

  <link name="base_link"/>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.43 0.12 0.07"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.43 0.12 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.04"/>
    </inertial>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Left Front Wheel & Steer -->
  <link name="fl_steer">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="chassis"/>
    <child link="fl_steer"/>
    <origin xyz="0.16 0.085 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="10.0" velocity="5.0"/>
  </joint>

  <link name="fl_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="fl_steer"/>
    <child link="fl_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right Front Wheel & Steer -->
  <link name="fr_steer">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="chassis"/>
    <child link="fr_steer"/>
    <origin xyz="0.16 -0.085 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="10.0" velocity="5.0"/>
  </joint>

  <link name="fr_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="fr_steer"/>
    <child link="fr_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Wheels -->
  <link name="rl_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rl_wheel"/>
    <origin xyz="-0.16 0.085 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rr_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rr_wheel"/>
    <origin xyz="-0.16 -0.085 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

<!-- LiDAR Sensor (교재 표준 규격 반영) -->
  <xacro:if value="$(arg with_lidar)">
    <link name="laser_frame">
      <visual>
        <geometry><cylinder radius="0.025" length="0.025"/></geometry>
        <material name="red"><color rgba="0.9 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.025" length="0.025"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" iyy="0.00001" izz="0.000015" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent link="chassis"/>
      <child link="laser_frame"/>
      <!-- z를 0.10에서 0.125로 올려 차체 위로 완전히 노출시킴 -->
      <origin xyz="0.10 0 0.125" rpy="0 0 0"/>
    </joint>

    <gazebo reference="laser_frame">
      <sensor name="team03_lidar" type="gpu_lidar">
        <gz_frame_id>team03/laser_frame</gz_frame_id>
        <topic>/team03/scan_03</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>max_velocit
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592</min_angle>
              <max_angle>3.141592</max_angle>
            </horizontal>
          </scan>
          <range>
            <!-- 최소 거리를 0.05m로 완화 -->
            <min>0.05</min>
            <max>15.0</max>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Camera Sensor (B팀 공식 규격: 640x480, 10Hz, 17도 상향각) -->
  <xacro:if value="$(arg with_camera)">
    <link name="camera_link">
      <visual>
        <geometry><box size="0.035 0.05 0.03"/></geometry>
        <material name="dark"><color rgba="0.08 0.08 0.08 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.035 0.05 0.03"/></geometry>
      </collision>
      <inertial>
        <mass value="0.04"/>
        <inertia ixx="0.000012" iyy="0.000008" izz="0.000013" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- 신호등 판독을 위해 카메라를 위쪽으로 약 17도(-0.30 rad) 틸트 -->
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="0.14 0 0.15" rpy="0 -0.30 0"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/team03/camera/image_03</topic>
        <gz_frame_id>team03/camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Gazebo Ackermann Control Plugin -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <wheel_base>0.32</wheel_base>
      <wheel_separation>0.17</wheel_separation>
      <wheel_radius>0.04</wheel_radius>
      <steering_limit>0.5235987756</steering_limit>
      <steer_p_gain>10</steer_p_gain>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>4.5</max_velocity>
      <topic>/team03/cmd_vel_03</topic>
      <odom_topic>/team03/odom_03</odom_topic>
      <tf_topic>/team03/tf_03</tf_topic>
      <frame_id>team03/odom</frame_id>
      <child_frame_id>team03/base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/team03/joint_states_03</topic>
    </plugin>
  </gazebo>
  <!-- URRC Stage 1: non-physical IMU on existing chassis -->
  <gazebo reference="chassis">
    <sensor name="team03_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/team03/imu_03</topic>
      <gz_frame_id>chassis</gz_frame_id>
    </sensor>
  </gazebo>

</robot>