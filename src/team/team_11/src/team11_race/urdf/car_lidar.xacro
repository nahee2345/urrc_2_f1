<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.025"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia
        ixx="0.0000104167"
        iyy="0.0000104167"
        izz="0.000015625"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.190 0 0.040"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>/team_11/scan</topic>
      <gz_frame_id>team_11/lidar_link</gz_frame_id>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.05</min>
          <max>18.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
