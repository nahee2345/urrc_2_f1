<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>

    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">

      <!-- 4-wheel drive (prevents front-wheel drag & rear-wheel slip) -->
      <left_joint>rear_left_wheel_joint</left_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <right_joint>front_right_wheel_joint</right_joint>

      <!-- front wheel steering -->
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>

      <!-- vehicle geometry -->
      <wheel_base>${L}</wheel_base>
      <wheel_separation>${T}</wheel_separation>
      <kingpin_width>${T}</kingpin_width>
      <wheel_radius>${R}</wheel_radius>

      <!-- steering limit: 30 deg -->
      <steering_limit>0.5235987756</steering_limit>

      <steer_p_gain>10</steer_p_gain>

      <!-- practice speed & acceleration limits -->
      <min_velocity>-1.0</min_velocity>
      <max_velocity>8.0</max_velocity>
      <min_acceleration>-10.0</min_acceleration>
      <max_acceleration>6.0</max_acceleration>

      <!-- Gazebo command topic -->
      <topic>/team_11/cmd_vel</topic>

      <!-- odometry / tf -->
      <odom_topic>/team_11/odom</odom_topic>
      <tf_topic>/team_11/tf</tf_topic>

      <frame_id>team_11/odom</frame_id>
      <child_frame_id>team_11/base_link</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

    </plugin>


    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <topic>/team_11/joint_states</topic>

    </plugin>

  </gazebo>

</robot>