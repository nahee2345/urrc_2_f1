<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="L" value="0.32"/>
  <xacro:property name="T" value="0.17"/>
  <xacro:property name="R" value="0.04"/>
  <xacro:property name="W" value="0.03"/>
  <xacro:property name="Z_CENTER" value="0.085"/>
  <xacro:property name="limit" value="0.5235987756"/>

  <!-- base_link: 3D geometric center of the full vehicle AABB (0.085 m above ground). -->
  <link name="base_link"/>

  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="body">
    <visual>
      <geometry>
        <box size="0.43 0.12 0.07"/>
      </geometry>
      <material name="cool_off_white">
        <color rgba="0.902 0.941 0.980 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.43 0.12 0.07"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.5"/>
      <inertia
        ixx="0.0024125"
        iyy="0.023725"
        izz="0.0249125"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name">

    <link name="${name}_wheel">
      <visual>
        <origin rpy="1.5707963268 0 0"/>
        <geometry>
          <cylinder radius="${R}" length="${W}"/>
        </geometry>
        <material name="black">
          <color rgba="0.02 0.02 0.02 1"/>
        </material>
      </visual>

      <collision>
        <origin rpy="1.5707963268 0 0"/>
        <geometry>
          <cylinder radius="${R}" length="${W}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.15"/>
        <inertia
          ixx="0.00007125"
          iyy="0.00012"
          izz="0.00007125"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>

    <gazebo reference="${name}_wheel">
      <mu1>1.2</mu1>
      <mu2>1.0</mu2>
    </gazebo>

  </xacro:macro>

  <xacro:macro name="spin" params="name parent xyz">

    <xacro:wheel name="${name}"/>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}_wheel"/>
      <origin xyz="${xyz}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.0005"/>
    </joint>

  </xacro:macro>

  <xacro:spin
    name="rear_left"
    parent="base_link"
    xyz="${-L/2} ${T/2} ${R - Z_CENTER}"/>

  <xacro:spin
    name="rear_right"
    parent="base_link"
    xyz="${-L/2} ${-T/2} ${R - Z_CENTER}"/>

  <xacro:macro name="front" params="name y">

    <link name="${name}_steer">
      <inertial>
        <mass value="0.02"/>
        <inertia
          ixx="0.00001"
          iyy="0.00001"
          izz="0.00001"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>

    <joint name="${name}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${name}_steer"/>
      <origin xyz="${L/2} ${y} ${R - Z_CENTER}"/>
      <axis xyz="0 0 1"/>
      <limit
        lower="${-limit}"
        upper="${limit}"
        effort="10"
        velocity="2"/>
      <dynamics damping="0.2"/>
    </joint>

    <xacro:spin
      name="${name}"
      parent="${name}_steer"
      xyz="0 0 0"/>

  </xacro:macro>

  <xacro:front name="front_left" y="${T/2}"/>
  <xacro:front name="front_right" y="${-T/2}"/>

</robot>