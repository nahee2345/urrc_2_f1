      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit><dynamics><damping>0.020</damping></dynamics></axis>
    </joint>
    
    <link name="start_camera_link">
      <pose>0.110 0 0.010 0 0 0</pose>
      <inertial><mass>0.010</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz></inertia></inertial>
      <visual name="camera_housing"><geometry><box><size>0.024 0.020 0.016</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <collision name="camera_housing"><geometry><box><size>0.024 0.020 0.016</size></box></geometry></collision>
      <sensor name="start_camera" type="camera">
        <pose>0.013 0 0 0 -0.48 0</pose>
        <topic>/team_10/start_camera_image_10</topic><always_on>true</always_on><update_rate>20</update_rate>
        <camera><horizontal_fov>1.0</horizontal_fov><image><width>400</width><height>300</height><format>R8G8B8</format></image><clip><near>0.03</near><far>50</far></clip></camera>
      </sensor>
    </link>
    <joint name="start_camera_joint" type="fixed"><parent>base_link</parent><child>start_camera_link</child></joint>

    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <topic>/model/team_10/cmd_vel</topic>
      <kingpin_width>0.168</kingpin_width>
      <steering_limit>0.488692</steering_limit>
      
      <steer_p_gain>6.0</steer_p_gain>
      <wheel_base>0.340</wheel_base>
      <wheel_separation>0.198</wheel_separation>
      <wheel_radius>0.038</wheel_radius>
      <min_velocity>-10.1</min_velocity><max_velocity>10.1</max_velocity>
      <min_acceleration>-4.0</min_acceleration><max_acceleration>4.0</max_acceleration>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>