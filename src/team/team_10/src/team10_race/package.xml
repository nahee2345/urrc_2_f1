<?xml version="1.0"?>
<package format="3">
  <name>team10_race</name>
  <version>0.1.0</version>
  <description>Hanla LiDAR-only wall-following race entry for URRC.</description>
  <maintainer email="student@example.com">Hanla Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
