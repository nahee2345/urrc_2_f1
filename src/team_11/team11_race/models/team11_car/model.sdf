          <velocity>100</velocity></limit><dynamics /></axis>
    </joint>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/team11/joint_states_11</topic><update_rate>50</update_rate>
      <joint_name>front_left_steer_joint</joint_name><joint_name>front_right_steer_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_spin_joint</left_joint><left_joint>rear_left_spin_joint</left_joint><right_joint>front_right_spin_joint</right_joint>
      <right_joint>rear_right_spin_joint</right_joint><left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint><wheel_separation>.214</wheel_separation><kingpin_width>.214</kingpin_width>
      <wheel_base>.34</wheel_base><wheel_radius>.040</wheel_radius><steering_limit>.520</steering_limit><min_velocity>-12</min_velocity>
      <!-- gazebo-sim8: angular yaw must permit negative yaw for right turns; adapter blocks reversing --><max_velocity>15</max_velocity>
      <min_acceleration>-5</min_acceleration><max_acceleration>2</max_acceleration><topic>/team11/cmd_vel_11</topic><odom_topic>/team11/odom_11</odom_topic>
      <tf_topic>/team11/gz_tf_11</tf_topic><odom_publish_frequency>25</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
    <publish_link_pose>true</publish_link_pose>
    <publish_model_pose>true</publish_model_pose>
    <publish_nested_model_pose>false</publish_nested_model_pose>
    <use_pose_vector_msg>true</use_pose_vector_msg>
    <update_frequency>40</update_frequency>
    <topic>/team11/pose_11</topic>
  </plugin>
  </model>
</sdf>
