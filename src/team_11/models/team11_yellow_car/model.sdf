<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9"><model name="team11_yellow_car" canonical_link="base_link">
<static>false</static><self_collide>false</self_collide>
<!-- Geometric bounds in local model frame: x[-.265,+.265], y[-.125,+.125],
     z[-.09,+.09]. Thus base_link origin (0,0,0) is 3D midpoint. 
     Spawn height on flat road = road_z + 0.09 m. -->
<link name="base_link">
<inertial><mass>1.6</mass><inertia><ixx>0.004</ixx><iyy>0.038</iyy><izz>0.039</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
<collision name="chassis_collision"><geometry><box><size>.53 .22 .11</size></box></geometry></collision>
<visual name="chassis_yellow"><geometry><box><size>.53 .22 .11</size></box></geometry><material><ambient>0.94 0.72 0.02 1</ambient><diffuse>1 0.82 0.025 1</diffuse><specular>0.3 0.3 0.15 1</specular></material></visual>
<visual name="windshield"><pose>.065 0 .054 0 0 0</pose><geometry><box><size>.15 .16 .005</size></box></geometry><material><ambient>.045 .045 .05 1</ambient><diffuse>.09 .09 .1 1</diffuse></material></visual>
<sensor name="team11_lidar" type="gpu_lidar"><pose>0 0 .068 0 0 0</pose>
<topic>/scan_11</topic><update_rate>15</update_rate><always_on>true</always_on><visualize>false</visualize>
<lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal></scan><range><min>.06</min><max>20</max><resolution>.01</resolution></range></lidar>
</sensor>
<sensor name="team11_start_camera" type="camera"><pose>.245 0 .02 0 -0.16 0</pose>
<topic>/camera_11</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
<camera><horizontal_fov>1.8</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>.04</near><far>40</far></clip></camera></sensor>
<!-- Narrow-field start-only camera shares the existing onboard mount position.
     No chassis protrusion; no driving decisions may use camera pixels. -->
<sensor name="team11_start_zoom_camera" type="camera"><pose>.245 0 .02 0 -0.045 0</pose>
<topic>/camera_zoom_11</topic><update_rate>10</update_rate><always_on>true</always_on><visualize>false</visualize>
<camera><horizontal_fov>.65</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>.04</near><far>40</far></clip></camera></sensor>
<!-- +X is physical front. Lamps distinguish nose and tail in Gazebo. -->
<visual name="front_marker_left"><pose>.263 .075 0 0 0 0</pose><geometry><box><size>.004 .025 .018</size></box></geometry><material><emissive>0.95 0.95 0.8 1</emissive><diffuse>0.95 0.95 0.8 1</diffuse></material></visual>
<visual name="front_marker_right"><pose>.263 -.075 0 0 0 0</pose><geometry><box><size>.004 .025 .018</size></box></geometry><material><emissive>0.95 0.95 0.8 1</emissive><diffuse>0.95 0.95 0.8 1</diffuse></material></visual>
<visual name="rear_marker_left"><pose>-.263 .075 0 0 0 0</pose><geometry><box><size>.004 .025 .018</size></box></geometry><material><emissive>0.85 0.02 0.02 1</emissive><diffuse>0.85 0.02 0.02 1</diffuse></material></visual>
<visual name="rear_marker_right"><pose>-.263 -.075 0 0 0 0</pose><geometry><box><size>.004 .025 .018</size></box></geometry><material><emissive>0.85 0.02 0.02 1</emissive><diffuse>0.85 0.02 0.02 1</diffuse></material></visual>
<visual name="lidar_body"><pose>0 0 .075 0 0 0</pose><geometry><cylinder><radius>.015</radius><length>.03</length></cylinder></geometry><material><ambient>.045 .045 .05 1</ambient><diffuse>.09 .09 .1 1</diffuse></material></visual>
</link>
<link name="front_left_knuckle"><pose relative_to="base_link">.18 .102 -.045 0 0 0</pose><inertial><mass>0.055</mass><inertia><ixx>0.00012</ixx><iyy>0.00012</iyy><izz>0.00012</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link>
<joint name="front_left_steering_joint" type="revolute"><parent>base_link</parent><child>front_left_knuckle</child><axis><xyz>0 0 1</xyz><limit><lower>-.5235987756</lower><upper>.5235987756</upper><effort>20</effort><velocity>4</velocity></limit></axis></joint>
<link name="front_left_wheel"><pose relative_to="base_link">.18 .102 -.045 -1.5707963268 0 0</pose><inertial><mass>0.105</mass><inertia><ixx>0.00013</ixx><iyy>0.0002</iyy><izz>0.00013</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
<collision name="tire_collision"><geometry><cylinder><radius>.045</radius><length>.046</length></cylinder></geometry><surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface></collision>
<visual name="tire_visual"><geometry><cylinder><radius>.045</radius><length>.046</length></cylinder></geometry><material><ambient>.045 .045 .05 1</ambient><diffuse>.09 .09 .1 1</diffuse></material></visual>
</link>
<joint name="front_left_wheel_joint" type="revolute"><parent>front_left_knuckle</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>30</effort><velocity>250</velocity></limit></axis></joint><link name="front_right_knuckle"><pose relative_to="base_link">.18 -.102 -.045 0 0 0</pose><inertial><mass>0.055</mass><inertia><ixx>0.00012</ixx><iyy>0.00012</iyy><izz>0.00012</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link>
<joint name="front_right_steering_joint" type="revolute"><parent>base_link</parent><child>front_right_knuckle</child><axis><xyz>0 0 1</xyz><limit><lower>-.5235987756</lower><upper>.5235987756</upper><effort>20</effort><velocity>4</velocity></limit></axis></joint>
<link name="front_right_wheel"><pose relative_to="base_link">.18 -.102 -.045 -1.5707963268 0 0</pose><inertial><mass>0.105</mass><inertia><ixx>0.00013</ixx><iyy>0.0002</iyy><izz>0.00013</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
<collision name="tire_collision"><geometry><cylinder><radius>.045</radius><length>.046</length></cylinder></geometry><surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface></collision>
<visual name="tire_visual"><geometry><cylinder><radius>.045</radius><length>.046</length></cylinder></geometry><material><ambient>.045 .045 .05 1</ambient><diffuse>.09 .09 .1 1</diffuse></material></visual>
</link>
<joint name="front_right_wheel_joint" type="revolute"><parent>front_right_knuckle</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>30</effort><velocity>250</velocity></limit></axis></joint>
<link name="rear_left_wheel"><pose relative_to="base_link">-.18 .102 -.045 -1.5707963268 0 0</pose><inertial><mass>0.105</mass><inertia><ixx>0.00013</ixx><iyy>0.0002</iyy><izz>0.00013</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
<collision name="tire_collision"><geometry><cylinder><radius>.045</radius><length>.046</length></cylinder></geometry><surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface></collision>
<visual name="tire_visual"><geometry><cylinder><radius>.045</radius><length>.046</length></cylinder></geometry><material><ambient>.045 .045 .05 1</ambient><diffuse>.09 .09 .1 1</diffuse></material></visual>
</link>
<joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>30</effort><velocity>250</velocity></limit></axis></joint>
<link name="rear_right_wheel"><pose relative_to="base_link">-.18 -.102 -.045 -1.5707963268 0 0</pose><inertial><mass>0.105</mass><inertia><ixx>0.00013</ixx><iyy>0.0002</iyy><izz>0.00013</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
<collision name="tire_collision"><geometry><cylinder><radius>.045</radius><length>.046</length></cylinder></geometry><surface><friction><ode><mu>1.3</mu><mu2>1.3</mu2></ode></friction></surface></collision>
<visual name="tire_visual"><geometry><cylinder><radius>.045</radius><length>.046</length></cylinder></geometry><material><ambient>.045 .045 .05 1</ambient><diffuse>.09 .09 .1 1</diffuse></material></visual>
</link>
<joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>30</effort><velocity>250</velocity></limit></axis></joint>
<plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
<left_joint>rear_left_wheel_joint</left_joint><right_joint>rear_right_wheel_joint</right_joint>
<left_steering_joint>front_left_steering_joint</left_steering_joint>
<right_steering_joint>front_right_steering_joint</right_steering_joint>
<wheel_separation>.204</wheel_separation><wheel_base>.36</wheel_base><wheel_radius>.045</wheel_radius>
<topic>/model/team_11/cmd_vel_11</topic><odom_topic>/model/team_11/odometry_11</odom_topic>
<odom_publish_frequency>50</odom_publish_frequency>
</plugin>
</model></sdf>
